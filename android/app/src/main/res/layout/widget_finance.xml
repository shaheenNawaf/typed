<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_finance_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Same header as the other Typed widgets. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@string/widget_app_name"
            android:src="@drawable/ic_typed" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:text="@string/widget_finance_title"
            android:textColor="@color/widget_fg"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_finance_month"
        android:text="@string/preview_finance_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_finance_balance"
        android:text="@string/preview_finance_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_fg"
        android:textSize="22sp" />

    <LinearLayout
        android:id="@+id/widget_finance_totals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp">
        <TextView
            android:id="@+id/widget_finance_income_value"
        android:text="@string/preview_finance_income"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_income"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_finance_expense_value"
        android:text="@string/preview_finance_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_finance_budget_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_finance_budget_label"
        android:text="@string/preview_finance_budget"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/widget_finance_budget_amount"
        android:text="@string/preview_finance_budget_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/widget_finance_budget_progress"
            android:max="100"
            android:progress="64"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:progressTint="@color/widget_accent"
            android:progressBackgroundTint="@color/widget_track"
            android:progressBackgroundTintMode="src_in" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_finance_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:id="@+id/widget_finance_expense"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:gravity="center"
            android:text="@string/widget_add_expense"
            android:textColor="@color/widget_accent"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_finance_income"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:gravity="center"
            android:text="@string/widget_add_income"
            android:textColor="@color/widget_income"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
