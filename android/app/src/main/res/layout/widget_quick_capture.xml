<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/widget_quick_label"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_typed"
            android:contentDescription="Typed" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_quick_title"
            android:textColor="@color/widget_fg"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="@string/widget_quick_sub"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- One-tap transactions: same intents the finance widget uses. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_quick_expense"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/widget_add_expense"
            android:textColor="@color/widget_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_quick_income"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_card_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/widget_add_income"
            android:textColor="@color/widget_income"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_quick_capture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_accent_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_plus"
            android:contentDescription="Add"
            android:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
             android:text="@string/widget_new_note"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
